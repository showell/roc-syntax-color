# Syntax coloring for web pages: code text in, HTML with colored spans out.
# SyntaxColor is the interface; each language's lexer is a module of its own.
package
	[
		Bytes,
		CSyntax,
		CSyntaxSpec,
		JsSyntax,
		OdinSyntax,
		OdinSyntaxSpec,
		PythonLiteral,
		PythonSyntax,
		PythonSyntaxSpec,
		RocSyntax,
		ShaleSyntax,
		Span,
		SyntaxColor,
		ZigSyntax,
	]
	{}
