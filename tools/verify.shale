-- budget: steps=600000000 arena_bytes=2000000000 read_bytes=400000000 call_bytes=40000000 output_bytes=200000
-- This is roc-syntax-color's gate: every check of the package, in one run.
-- From the repository's root:
--
--   shale tools/verify.shale
--
-- It prints a line a check, PASS or FAIL with its numbers, and fails unless
-- every one passed:
--   - Shale's Roc recipes over every .roc file git tracks, each count held
--     exact (tools/lints.shale, whose lines this takes);
--   - `roc fmt --check` over the repository's Roc, by the Roc that roc-version
--     pins (tools:roc-<pin>/roc);
--   - `roc check` of the harness, which reaches every module, with no error and
--     no warning;
--   - `roc test package/main.roc`, which reaches every module the package
--     lists, a `*Spec.roc` of tests too, its count held to the `expect` lines in
--     the package, and both to EXPECTS;
--   - the oracle (each sample that differs is written, its first differing
--     line, to .zig-cache/syntax_color/differences.txt): each sample of
--     oracle/*.jsonl, colored by the harness, held byte for byte to what was
--     recorded, and each corpus's count held to CORPORA. Every sample is the
--     package's own answer, read by eye (tools/record_roc_fixtures.shale,
--     tools/record_shale_fixtures.shale, tools/record_js_fixtures.shale,
--     tools/record_zig_fixtures.shale, tools/record_c_fixtures.shale,
--     tools/record_odin_fixtures.shale, tools/record_python_fixtures.shale).
--
-- A Roc block is colored as it reads in its file: the harness colors the file
-- and takes the lines the block's note names, as the book does. The blocks are
-- also colored alone, with no file around them, and ALONE_MATCHES holds how
-- many of those come out the same, since a block cut from a function's body
-- reads differently alone.
use("./samples.shale")

const WANT = "roc-pin: the pinned nightly, for roc-syntax-color's gate"
const HARNESS_DIR = "harness"
const PACKAGE_DIR = "package"
const WORK = ".zig-cache/syntax_color"
const MARK = "<!-- syntax_color answer -->\n"
const ARG_BYTES = 700000
const EXPECTS = 269
const CORPORA = {roc_files = 76, roc_blocks = 223, shale_files = 109, js_files = 13, zig_files = 13, c_files = 13, odin_files = 13, python_files = 13}
const ALONE_MATCHES = 219

const board = {lines = {}, failed = 0}

function say(ok, what)
  local mark = "FAIL"
  if ok then mark = "PASS" else board.failed = board.failed + 1 end
  push(board.lines, mark .. "  " .. what)
  print(mark .. "  " .. what)
  return nil
end

-- Every request, with what it must answer: {corpus, name, argv, want}.
function requests()
  local out = {}
  local files = {}
  for r in read_corpus("roc_files") do
    local text = text_of(r.html)
    files[r.name] = text
    push(out, {corpus = "roc_files", name = r.name, argv = {"roc", text}, want = r.html})
  end
  for r in read_corpus("roc_blocks") do
    push(out, {corpus = "roc_blocks", name = r.name, argv = {"roc-block", files[r.note.path], block_spec(r.note, files[r.note.path])}, want = r.html})
    push(out, {corpus = "roc_blocks_alone", name = r.name, argv = {"roc", text_of(r.html)}, want = r.html})
  end
  for r in read_corpus("shale_files") do
    push(out, {corpus = "shale_files", name = r.name, argv = {"shale", text_of(r.html)}, want = r.html})
  end
  for r in read_corpus("js_files") do
    push(out, {corpus = "js_files", name = r.name, argv = {"js", text_of(r.html)}, want = r.html})
  end
  for r in read_corpus("zig_files") do
    push(out, {corpus = "zig_files", name = r.name, argv = {"zig", text_of(r.html)}, want = r.html})
  end
  for r in read_corpus("c_files") do
    push(out, {corpus = "c_files", name = r.name, argv = {"c", text_of(r.html)}, want = r.html})
  end
  for r in read_corpus("odin_files") do
    push(out, {corpus = "odin_files", name = r.name, argv = {"odin", text_of(r.html)}, want = r.html})
  end
  for r in read_corpus("python_files") do
    push(out, {corpus = "python_files", name = r.name, argv = {"python", text_of(r.html)}, want = r.html})
  end
  return out
end

-- The harness's answers to the requests, in runs of at most ARG_BYTES of
-- arguments each.
function answers(tool, reqs)
  local got = {}
  local at = 1
  while at <= #reqs do
    local argv = {tool}
    local bytes = 0
    local i = at
    while i <= #reqs and (i == at or bytes < ARG_BYTES) do
      for a in reqs[i].argv do
        push(argv, a)
        bytes = bytes + #a
      end
      i = i + 1
    end
    local r = run(argv, {timeout_ms = 300000, whole = 60000000, want = WANT})
    if r.code ~= 0 then fail("verify: the harness exited " .. r.code .. ": " .. sub(r.out, 1, 400)) end
    local pieces = split(r.out, MARK)
    if pieces[1] ~= "" then fail("verify: the harness said something before its first answer") end
    if #pieces - 1 ~= i - at then fail("verify: " .. (i - at) .. " requests got " .. (#pieces - 1) .. " answers") end
    for p in drop(pieces, 1) do push(got, p) end
    at = i
  end
  return got
end

-- The first line where `got` and `want` differ, both ways, for a reader.
function first_difference(got, want)
  local g = split(got, "\n")
  local w = split(want, "\n")
  local i = 1
  while i <= #g and i <= #w and g[i] == w[i] do i = i + 1 end
  return "  line " .. i .. "\n  got:  " .. get(g, i, "(none)") .. "\n  want: " .. get(w, i, "(none)")
end

function check_oracle(tool)
  local reqs = requests()
  local got = answers(tool, reqs)
  local tally = {}
  local alone = 0
  local diffs = {}
  local i = 1
  while i <= #reqs do
    local q = reqs[i]
    local same = got[i] == q.want
    if not same then push(diffs, q.corpus .. ": " .. q.name .. "\n" .. first_difference(got[i], q.want)) end
    if q.corpus == "roc_blocks_alone" then
      if same then alone = alone + 1 end
    else
      if not has_key(tally, q.corpus) then tally[q.corpus] = {samples = 0, wrong = {}} end
      local t = tally[q.corpus]
      t.samples = t.samples + 1
      if not same then push(t.wrong, q.name) end
    end
    i = i + 1
  end
  replace(WORK .. "/differences.txt", join(diffs, "\n\n") .. "\n")
  for corpus in sort(keys(CORPORA)) do
    local t = get(tally, corpus, {samples = 0, wrong = {}})
    for w in t.wrong do print("      " .. corpus .. ": " .. w .. ": differs") end
    local ok = t.samples == CORPORA[corpus] and #t.wrong == 0
    say(ok, corpus .. ": " .. t.samples .. " samples (held at " .. CORPORA[corpus] .. "), " .. (t.samples - #t.wrong) .. " match byte for byte, " .. #t.wrong .. " differ")
  end
  say(alone == ALONE_MATCHES, "roc_blocks colored alone: " .. alone .. " match (held at " .. ALONE_MATCHES .. ")")
  return nil
end

-- The ✗ and ● lines of a compiler's output.
function marks(out)
  local n = 0
  for l in lines(out) do
    if contains(l, "✗") or contains(l, "●") then n = n + 1 end
  end
  return n
end

function count_expects()
  local n = 0
  for p in glob(PACKAGE_DIR .. "/*.roc") do
    for l in lines(read(p)) do
      if starts_with(l, "expect") then n = n + 1 end
    end
  end
  return n
end

-- **THE PINNED ROC**: tools:roc-<pin>/roc, roc-version naming the pin (pins
-- live side by side; the PATH's may be another project's). A missing pin file,
-- a missing binary and a binary whose `roc version` isn't the pin each stop the
-- run.
function pinned_roc()
  if not exists("roc-version") then fail("verify: no roc-version: run from the repository's root") end
  local pin = trim(read("roc-version"))
  local at = "tools:roc-" .. pin .. "/roc"
  if not exists(at) then fail("verify: no " .. at .. ": install the pinned nightly " .. pin .. " at ~/tools/roc-" .. pin .. "/") end
  local said = run({real(at), "version"}, {timeout_ms = 30000, whole = 4000, want = WANT})
  if trim(said.out) ~= "Roc compiler version " .. pin then
    fail("verify: " .. at .. " is " .. trim(said.out) .. ", not " .. pin)
  end
  return real(at)
end

-- Shale's Roc recipes: tools/lints.shale prints a `PASS` or `FAIL` line a
-- recipe, each a line here. A run that printed none, or failed with every
-- line passing, is a line of its own.
local lints = run({"shale", "tools/lints.shale"}, {cwd = ".", timeout_ms = 300000, tail = 60})
local lint_lines = 0
local lint_failed = false
for l in lines(lints.out) do
  if starts_with(l, "PASS  ") or starts_with(l, "FAIL  ") then
    lint_lines = lint_lines + 1
    if starts_with(l, "FAIL  ") then lint_failed = true end
    say(starts_with(l, "PASS  "), sub(l, 7))
  end
end
if lint_lines == 0 or (lints.code ~= 0 and not lint_failed) then
  say(false, "tools/lints.shale exited " .. lints.code .. ": " .. trim(lints.out))
end

local roc = pinned_roc()
local f = run({roc, "fmt", "--check", "package", "harness"}, {cwd = ".", timeout_ms = 60000, tail = 20, want = WANT})
say(f.code == 0, "roc fmt --check package harness" .. (f.code == 0 and "" or (": " .. trim(f.out))))

local c = run({roc, "check", "main.roc"}, {cwd = HARNESS_DIR, timeout_ms = 120000, whole = 400000, want = WANT})
local c_marks = marks(c.out)
say(c.code == 0 and c_marks == 0 and contains(c.out, "No errors found"), "roc check harness/main.roc: " .. c_marks .. " errors and warnings")

local t = run({roc, "test", "main.roc"}, {cwd = PACKAGE_DIR, timeout_ms = 300000, tail = 40, want = WANT})
local passed = re_find(t.out, "All \\(([0-9]+)\\) tests passed")
local ran = passed ~= nil and tonumber(passed.groups[1]) or -1
local written = count_expects()
say(t.code == 0 and ran == written and ran == EXPECTS, "roc test package/main.roc: " .. ran .. " passed, " .. written .. " expect lines in package/ (held at " .. EXPECTS .. ")")
if t.code ~= 0 then print(trim(t.out)) end

mkdir(WORK)
local tool = real(WORK) .. "/harness"
local b = run({roc, "build", "--opt=dev", "main.roc", "--output=" .. tool}, {cwd = HARNESS_DIR, timeout_ms = 300000, whole = 400000, want = WANT})
local b_marks = marks(b.out)
say(b.code == 0 and b_marks == 0, "roc build --opt=dev harness/main.roc: " .. b_marks .. " errors and warnings")
if b.code == 0 then check_oracle(tool) else say(false, "the oracle: no harness to run") end

if board.failed > 0 then fail("verify: " .. board.failed .. " of " .. #board.lines .. " checks failed") end
print("verify: " .. #board.lines .. " of " .. #board.lines .. " passed")
