-- budget: steps=400000000 arena_bytes=1500000000 reads=20000 read_bytes=400000000 output_bytes=200000 call_bytes=40000000
-- This records the Shale samples the package is held to, as the Shale
-- cookbook's color_shale.shale colors them. It runs from a roc-apps checkout,
-- with this repository beside it under the `repos:` mount, and needs the books
-- book's checkout and the Shale cookbook:
--
--   cd <roc-apps checkout> && shale repos:roc-syntax-color/tools/record_shale_oracle.shale
--
-- color_shale runs on a scratch folder, so nothing in the checkout changes.
-- It writes oracle/shale_files.jsonl, a sample a line: every cookbook recipe,
-- the books book's Shale files and the Shale functions and line ranges its
-- book quotes. A line is {name, outcome, html}. The html is what color_shale
-- wrote between its <pre><code> tags, and the sample's text is that html with
-- its spans taken away and its five escapes undone, which color_shale checks
-- holds. The outcome is `colored`, or `refused` for a file color_shale gave no
-- page. The Roc samples are the package's own answers, frozen
-- (tools/record_roc_fixtures.shale).
const ORACLE = "repos:roc-syntax-color/oracle"
const COLOR_SHALE = "cookbook:color_shale.shale"
const COOKBOOK = "repos:shale/cookbook"
const BOOKS_BOOK = "build:lanes/books-book/books-book"
const SHALE_OPEN = "<pre><code class=\"language-shale\">"
const CLOSE = "</code></pre>"
const SHALE_CHUNK = 50

function escaped(text)
  local s = join(split(text, "&"), "&amp;")
  s = join(split(s, "<"), "&lt;")
  s = join(split(s, ">"), "&gt;")
  s = join(split(s, "\""), "&quot;")
  return join(split(s, "'"), "&#39;")
end

-- A file's lines through its last that isn't empty.
function file_lines(path)
  local ls = split(read(path), "\n")
  while #ls > 0 and ls[#ls] == "" do ls = take(ls, #ls - 1) end
  return ls
end

-- A top-level Shale function as the books book quotes it: the comment lines
-- right above it, through its `end`.
function function_text(path, name)
  local ls = file_lines(path)
  local first = 0
  local i = 1
  while i <= #ls do
    if starts_with(ls[i], "function " .. name .. "(") then first = i end
    i = i + 1
  end
  if first == 0 then fail("record_shale_oracle: no function " .. name .. " in " .. path) end
  local last = first
  while ls[last] ~= "end" do last = last + 1 end
  while first > 1 and starts_with(ls[first - 1], "--") do first = first - 1 end
  return join(slice(ls, first, last), "\n") .. "\n"
end

-- The lines from the one holding `from` through the one holding `to`.
function lines_text(path, from, to)
  local ls = file_lines(path)
  local first = 0
  local last = 0
  local i = 1
  while i <= #ls do
    if first == 0 and contains(ls[i], from) then first = i end
    if first ~= 0 and last == 0 and contains(ls[i], to) then last = i end
    i = i + 1
  end
  if first == 0 or last == 0 then fail("record_shale_oracle: no lines from [" .. from .. "] to [" .. to .. "] in " .. path) end
  return join(slice(ls, first, last), "\n") .. "\n"
end

-- The Shale the books book quotes in part, each written as a file of its own.
function shale_fragments(folder)
  local build = BOOKS_BOOK .. "/build.shale"
  local fragments = {
    {name = "books-book/build.shale, function anchored_line", text = function_text(build, "anchored_line")},
    {name = "roc-apps/canvas_apps/safari/tutorial/build.shale, function fenced_failure", text = function_text("canvas_apps/safari/tutorial/build.shale", "fenced_failure")},
    {name = "books-book/build.shale, the settings", text = lines_text(build, "-- Where the book's files are", "const CHECK_NEGATIVES = true")},
    {name = "books-book/build.shale, the prose check", text = lines_text(build, "local over = {}", "if #over > 0 then fail(")},
  }
  local files = {}
  local i = 1
  while i <= #fragments do
    local path = folder .. "/fragment" .. i .. ".shale"
    replace(path, fragments[i].text)
    push(files, {path = path, name = fragments[i].name})
    i = i + 1
  end
  return files
end

-- A path as a sample's name: the folder of its repo, without the mount.
function shale_name(path)
  if starts_with(path, COOKBOOK .. "/") then return "cookbook/" .. sub(path, #COOKBOOK + 2) end
  if starts_with(path, BOOKS_BOOK .. "/") then return "books-book/" .. sub(path, #BOOKS_BOOK + 2) end
  return path
end

function shale_records()
  local work = fresh_dir("scratch:", "syntax-color-shale")
  local files = {}
  for p in sort(glob(COOKBOOK .. "/**/*.shale")) do push(files, {path = p, name = shale_name(p)}) end
  for p in sort(glob(BOOKS_BOOK .. "/**/*.shale")) do push(files, {path = p, name = shale_name(p)}) end
  for f in shale_fragments(work) do push(files, f) end
  local out = work .. "/out"
  local at = 1
  while at <= #files do
    local chunk = {}
    local i = at
    while i <= #files and i < at + SHALE_CHUNK do
      push(chunk, files[i].path)
      i = i + 1
    end
    local r = run({"shale", COLOR_SHALE, "files=" .. join(chunk, ","), "out=" .. out}, {timeout_ms = 900000, tail = 200})
    if not contains(r.out, "color_shale: ") then
      print(r.out)
      fail("record_shale_oracle: color_shale said nothing of its files")
    end
    at = i
  end
  local records = {}
  local refused = 0
  for f in files do
    local page = out .. "/" .. substitute(f.path, ":", "/", {missing_ok = true}) .. ".html"
    if exists(page) then
      push(records, {name = f.name, outcome = "colored", html = between(read(page), SHALE_OPEN, CLOSE)})
    else
      push(records, {name = f.name, outcome = "refused", html = escaped(read(f.path))})
      refused = refused + 1
    end
  end
  print("record_shale_oracle: " .. #records .. " samples, " .. refused .. " refused")
  remove_tree(work)
  return records
end

function write_records(file, records)
  local out = {}
  for r in records do
    local line = {name = r.name, outcome = r.outcome, html = r.html}
    if has_key(r, "note") then line.note = r.note end
    push(out, json_write(line))
  end
  replace(ORACLE .. "/" .. file, join(out, "\n") .. "\n")
  return nil
end

mkdir(ORACLE)
write_records("shale_files.jsonl", shale_records())
